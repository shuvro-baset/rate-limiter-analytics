# Copy to .env and edit. Docker Compose reads this for PORT, DB_*, REDIS_PORT.
# Used for: docker compose up (port mapping + app/postgres/redis config)

PORT=3000
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rate_limiters_db
DB_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379